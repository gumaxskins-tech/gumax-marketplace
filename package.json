{
  "name": "gumax-marketplace",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm --workspace @gumax/database run generate",
    "db:validate": "npm --workspace @gumax/database run validate"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}

