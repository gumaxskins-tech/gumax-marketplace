# PostgreSQL / Prisma
DATABASE_URL="postgresql://user:password@localhost:5432/gumax_marketplace?schema=public"

# Runtime (never commit real values)
NODE_ENV="development"
PORT="3001"
LOG_LEVEL="info"

FX_PROVIDER="mock"
PAYMENT_PROVIDER="mock"
MARKET_PROVIDER="mock"
STEAM_PROVIDER="mock"
STORAGE_PROVIDER="local"
KYC_SIGNED_URL_TTL_SECONDS="300"

# Provider configuration belongs in the deployment secret store.
# YOUPIN_PROVIDER_BASE_URL=""
# PAYMENT_PROVIDER_WEBHOOK_SECRET=""
# STEAM_API_KEY=""
